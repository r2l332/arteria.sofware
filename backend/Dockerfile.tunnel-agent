FROM golang:1.24-bookworm AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /capillary ./cmd/tunnel-agent

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /capillary /usr/local/bin/capillary
RUN ln -s /usr/local/bin/capillary /usr/local/bin/arteria-agent
ENTRYPOINT ["capillary"]
